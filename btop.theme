# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#e7e9ea"

# Title color for boxes
theme[title]="#e7e9ea"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d3d3d3"

# Background color of selected item in processes box
theme[selected_bg]="#e7e9ea"

# Foreground color of selected item in processes box
theme[selected_fg]="#d3d3d3"

# Color of inactive/disabled text
theme[inactive_fg]="#626262"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e7e9ea"

# Background color of the percentage meters
theme[meter_bg]="#e7e9ea"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e7e9ea"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8a8a8a"
theme[mem_box]="#e7e9ea"
theme[net_box]="#8a8a8a"
theme[proc_box]="#d3d3d3"

# Box divider line and small boxes line color
theme[div_line]="#626262"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#e7e9ea"
theme[temp_mid]="#9e9e9e"
theme[temp_end]="#8a8a8a"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#767676"
theme[cpu_mid]="#626262"
theme[cpu_end]="#8a8a8a"

# Mem/Disk free meter
theme[free_start]="#8a8a8a"
theme[free_mid]="#626262"
theme[free_end]="#767676"

# Mem/Disk cached meter
theme[cached_start]="#626262"
theme[cached_mid]="#767676"
theme[cached_end]="#8a8a8a"

# Mem/Disk available meter
theme[available_start]="#9e9e9e"
theme[available_mid]="#8a8a8a"
theme[available_end]="#8a8a8a"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#e7e9ea"
theme[used_mid]="#767676"
theme[used_end]="#626262"

# Download graph colors
theme[download_start]="#9e9e9e"
theme[download_mid]="#8a8a8a"
theme[download_end]="#8a8a8a"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#e7e9ea"
theme[upload_mid]="#767676"
theme[upload_end]="#626262"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#767676"
theme[process_mid]="#626262"
theme[process_end]="#8a8a8a"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#000000"
theme[gradient_color_1]="#000000"
theme[gradient_color_2]="#e7e9ea"
theme[gradient_color_3]="#626262"
theme[gradient_color_4]="#626262"
theme[gradient_color_5]="#e7e9ea"
theme[gradient_color_6]="#e7e9ea"
theme[gradient_color_7]="#e7e9ea"
